# Copy to .env and adjust for your environment
DATABASE_URL=postgresql+psycopg2://pharma:pharma@localhost:5432/pharma_db

# JWT session auth (role-based login)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Demo signing-key seed. Private keys are derived from this + actor_id
# and stored as PEM files under STORAGE_DIR/keys (NEVER in the database).
# Production: use a strong random value, back it up in a KMS/HSM,
# and let each organisation hold its own private key.
HASHCHAIN_SECRET=change-me-demo-only

STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173
